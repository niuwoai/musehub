# MuseHub local configuration example.
# Copy to .env and adjust for your machine. Never put credentials in this file.

# HTTP listen address for the MuseHub server. Defaults to 127.0.0.1:8080.
MUSEHUB_BIND=127.0.0.1:8080

# Optional PostgreSQL connection URL. Without it, the server starts but /readyz reports not_configured.
# DATABASE_URL=postgres://localhost/musehub

# Migrate down (maintenance / acceptance only): when 1, idle pooled connections on this DB are
# ended before `musehub-migrate down` so 0001 teardown is not blocked. Do not set in production
# unless you understand the impact on other idle clients sharing the same database.
# MUSEHUB_MIGRATE_TERMINATE_IDLE_PEERS=1

# Product API (all required for /readyz=ready and REST/UI slice):
# MUSEHUB_GIT_ROOT=/var/lib/musehub/git
# MUSEHUB_SESSION_SECRET=
# MUSEHUB_BOOTSTRAP_ADMIN_PASSWORD=   # first boot only when DB has no principals
