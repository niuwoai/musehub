# MuseHub local configuration example.
# Copy to .env and adjust for your machine. Never put credentials in this file.

# HTTP listen address for the MuseHub server. Defaults to 127.0.0.1:8080.
MUSEHUB_BIND=127.0.0.1:8080

# Optional PostgreSQL connection URL. Without it, the server starts but /readyz reports not_configured.
# DATABASE_URL=postgres://localhost/musehub
