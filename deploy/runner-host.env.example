# Copy to deploy/runner-host.env on the dedicated Runner host and chmod 0600.
# Prefer a private VPN/network. API_BASE must use HTTPS; PostgreSQL must use TLS.
MUSEHUB_API_BASE=https://musehub.example.com
MUSEHUB_DATABASE_URL=postgres://musehub:REPLACE_ME@postgres.internal:5432/musehub?sslmode=verify-full
MUSEHUB_RUNNER_PAT=REPLACE_WITH_ORG_SCOPED_RUNNER_PAT
MUSEHUB_RUNNER_INSTANCE_ID=REPLACE_WITH_STABLE_UUID
MUSEHUB_OCI_REGISTRY=registry.internal:5000
# Comma-separated exact image references; every entry must include @sha256:<64 hex>.
MUSEHUB_JOB_ALLOWED_IMAGES=

# Host paths must be mounted from the control plane's authoritative stores.
MUSEHUB_GIT_ROOT_HOST=/srv/musehub/git
MUSEHUB_ARTIFACT_ROOT_HOST=/srv/musehub/artifacts
MUSEHUB_PIPELINE_WORKSPACE_ROOT_HOST=/srv/musehub/pipeline-workspaces

MUSEHUB_RUNNER_POLL_SECS=2
MUSEHUB_RUNNER_WORK_KINDS=all
MUSEHUB_REQUIRE_PIPELINE_OCI=1
