# Copy to /etc/musehub/storage-mirror.env and adjust to the host layout.
# SSH credentials are supplied to the service account out of band.
MUSEHUB_GIT_ROOT=/var/lib/musehub/git
MUSEHUB_ARTIFACT_ROOT=/var/lib/musehub/artifacts
MUSEHUB_STORAGE_MIRROR_TARGET=musehub-mirror@region-b.example.internal
MUSEHUB_STORAGE_MIRROR_REMOTE_ROOT=/srv/musehub-storage
MUSEHUB_STORAGE_MIRROR_STATE_DIR=/var/lib/musehub-storage-mirror
