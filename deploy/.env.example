# Copy to deploy/.env for local `docker compose` (generate secrets; never commit real values).

POSTGRES_PASSWORD=change-me-postgres
MUSEHUB_SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Required to create/deliver webhooks; generate with `openssl rand -base64 32` and keep outside database backups.
# MUSEHUB_WEBHOOK_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Optional external PostgreSQL HA writer endpoint; enable with docker-compose.external-postgres.yml.
# Use a stable proxy/VIP endpoint with TLS certificate verification; never point writes at a read replica.
# MUSEHUB_DATABASE_URL=<set a TLS-verified PostgreSQL HA writer URL in deploy/.env>
# Set to 1 when the public UI uses HTTPS; HTTPS OIDC redirect URIs enable Secure cookies automatically.
MUSEHUB_COOKIE_SECURE=0
# Optional GitHub OAuth App login (client ID/secret from GitHub OAuth App settings).
# MUSEHUB_GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-app-client-id
# MUSEHUB_GITHUB_OAUTH_CLIENT_SECRET=configure-in-your-secret-store
# MUSEHUB_GITHUB_OAUTH_REDIRECT_URI=https://musehub.example.com/api/v1/auth/github/callback
# Optional single-provider OIDC login; configure all except the optional client secret.
# MUSEHUB_OIDC_ISSUER_URL=https://idp.example.com/
# MUSEHUB_OIDC_CLIENT_ID=musehub
# MUSEHUB_OIDC_CLIENT_SECRET=configure-in-your-secret-store
# MUSEHUB_OIDC_REDIRECT_URI=https://musehub.example.com/api/v1/auth/oidc/callback
# Optional SAML SP-initiated SSO; enable with docker-compose.saml.yml overlay.
# IdP metadata must be signed by this pinned PEM certificate; ACS must use HTTPS.
# MUSEHUB_SAML_IDP_ENTITY_ID=https://idp.example.com/entity
# MUSEHUB_SAML_IDP_METADATA_HOST_PATH=/etc/musehub/saml/idp-metadata.xml
# MUSEHUB_SAML_METADATA_SIGNING_CERT_HOST_PATH=/etc/musehub/saml/metadata-signing-cert.pem
# MUSEHUB_SAML_SP_ENTITY_ID=https://musehub.example.com/saml/metadata
# MUSEHUB_SAML_ACS_URL=https://musehub.example.com/api/v1/auth/saml/acs
MUSEHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin
MUSEHUB_GATEWAY_HTTP_PORT=8080
# URL shown in UI/API for HTTP Git clone (gateway front door); set to your hostname or TLS origin.
MUSEHUB_PUBLIC_HTTP_ORIGIN=http://127.0.0.1:8080
# SSH Git clone hostname + port (separate musehub-git-ssh listener; see deploy/RUNBOOK.md)
MUSEHUB_PUBLIC_SSH_HOST=127.0.0.1
MUSEHUB_GIT_SSH_PORT=2222
MUSEHUB_GIT_SSH_LISTEN=0.0.0.0
# Gateway TLS (production): off | manual | acme — see deploy/RUNBOOK.md
MUSEHUB_GATEWAY_TLS_MODE=off
# MUSEHUB_GATEWAY_TLS_DOMAIN=musehub.your.corp
# MUSEHUB_ACME_EMAIL=ops@your.corp
# MUSEHUB_GATEWAY_HTTPS_PORT=443
# MUSEHUB_GATEWAY_HTTP_REDIRECT_PORT=80
# MUSEHUB_TLS_CERT_FILE=./tls/cert.pem
# MUSEHUB_TLS_KEY_FILE=./tls/key.pem
# Optional product MCP tools on /mcp (Bearer PAT still required)
MUSEHUB_MCP_PRODUCT=0
# Production worker overlay: docker compose -f docker-compose.yml -f docker-compose.production.yml
# See deploy/RUNBOOK.md and scripts/install-production-compose.sh
