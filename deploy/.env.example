# Copy to deploy/.env for local `docker compose` (generate secrets; never commit real values).

POSTGRES_PASSWORD=change-me-postgres
MUSEHUB_SESSION_SECRET=change-me-session-secret-at-least-32-chars
MUSEHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin
MUSEHUB_GATEWAY_HTTP_PORT=8080
# URL shown in UI/API for HTTP Git clone (gateway front door); set to your hostname or TLS origin.
MUSEHUB_PUBLIC_HTTP_ORIGIN=http://127.0.0.1:8080
# Optional product MCP tools on /mcp (Bearer PAT still required)
MUSEHUB_MCP_PRODUCT=0
# Production worker overlay: docker compose -f docker-compose.yml -f docker-compose.production.yml
# See deploy/RUNBOOK.md and scripts/install-production-compose.sh
